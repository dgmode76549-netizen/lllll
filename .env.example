# Chống spam: tối đa 8 lượt tương tác trong 10 giây, khóa 2 phút nếu vượt mức
SPAM_WINDOW_SECONDS=10
SPAM_MAX_REQUESTS=8
SPAM_BLOCK_SECONDS=120
SPAM_MAX_CONCURRENT=2
SPAM_MAX_TRACKED_USERS=10000

# Tốc độ kiểm tra trạng thái thuê số/OTP
OTP_POLL_INTERVAL_MS=1500
OTP_COUNTDOWN_UPDATE_SECONDS=15

# Cấu hình Supabase (PostgreSQL Database)
